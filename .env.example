# Local simulation is credential-free.
APP_ENV=local
STATE_BACKEND=local
AGENT_RUNTIME_MODE=deterministic
DEMO_API_KEY=
# Exposes only curated dashboard/story/summary/audit/health/card routes without
# authentication. Raw state, arbitrary mutations, A2A, and Pub/Sub stay protected.
PUBLIC_DASHBOARD=false
# Optional public hackathon controls. These permit only the four predefined synthetic
# scenario events, in order, with an expiring run token and an independent daily limit.
ENABLE_PUBLIC_DEMO=false
PUBLIC_DEMO_DAILY_LIMIT=25
PUBLIC_DEMO_TTL_MINUTES=30

# Google Cloud production configuration.
GOOGLE_CLOUD_PROJECT=
# Gemini 3.5 Flash-Lite Standard PayGo is available in global/us/eu.
GOOGLE_CLOUD_LOCATION=global
AGENT_REGISTRY_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
PUBSUB_TOPIC=enterprise-events
FIRESTORE_DATABASE=(default)
PUBSUB_PUSH_AUDIENCE=
PUBSUB_PUSH_SERVICE_ACCOUNT=

# Required hackathon models. Keep routine work on Flash-Lite.
GEMINI_ROUTINE_MODEL=gemini-3.5-flash-lite
GEMINI_COMPLEX_MODEL=gemini-3.5-flash
MAX_MODEL_CALLS_PER_WORKFLOW=4
MAX_DAILY_WORKFLOWS=100

# Agent role when the same image is deployed as separate services.
AGENT_ROLE=recall
PUBLIC_BASE_URL=http://localhost:8000
SUPPLY_AGENT_RESOURCE=agents/supply-agent
FINANCE_AGENT_RESOURCE=agents/finance-agent
ENABLE_CLOUD_TRACE=false

# Agent identities are fixed in code and are never accepted from model tool arguments.

# Optional build-time public-data credentials. Never commit real keys.
USDA_API_KEY=
OPENFDA_API_KEY=
